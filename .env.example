# Kopie als .env anlegen und ausfuellen. .env ist gitignored.

# --- Jobsuche-API der Bundesagentur fuer Arbeit ---
# Kein Secret: die clientId ist oeffentlich bekannt und wird als
# statischer Header X-API-Key mitgeschickt. Steht hier nur, damit sie
# nicht im Code hartkodiert ist.
JOBSUCHE_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
JOBSUCHE_API_KEY=jobboerse-jobsuche

# --- Suchprofil ---
JOBSUCHE_WAS=Data Engineer,Softwareentwickler
JOBSUCHE_WO=Hamburg
JOBSUCHE_UMKREIS_KM=30

# Zeitfenster in Tagen. Die API akzeptiert ausschliesslich 0, 1, 7, 14
# oder 28 - andere Werte verwirft sie kommentarlos und liefert dann alle
# Treffer statt der erwarteten Auswahl.
JOBSUCHE_VEROEFFENTLICHT_SEIT_TAGEN=7

# Zweiter Suchdurchgang ohne Ortsbindung. Nimmt nur Stellen mit, deren
# Homeoffice-Anteil mindestens dem folgenden Wert entspricht - bei 100
# also vollstaendig remote. Nur dann spielt der Arbeitsort keine Rolle.
JOBSUCHE_REMOTE_BUNDESWEIT=true
JOBSUCHE_REMOTE_MIN_PROZENT=100

# --- Kafka (self-hosted auf EC2) ---
# Adresse liefert: terraform -chdir=infra output -raw kafka_bootstrap_servers
# Muss der DNS-Name sein, nicht die IP - sonst schlaegt die
# Hostname-Pruefung gegen das Wildcard-Zertifikat fehl.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_RAW=jobs.raw
KAFKA_TOPIC_MATCHED=jobs.matched

# Der Broker ist oeffentlich erreichbar und nur durch SASL_SSL geschuetzt.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=jobradar

# Das Passwort steht nicht hier, sondern wird zur Laufzeit aus SSM
# gelesen. Hier nur der Name des Parameters.
KAFKA_PASSWORD_SSM_PARAMETER=/jobradar/kafka/user-password

# Pfad zum CA-Zertifikat als Vertrauensanker. Ablegen mit:
# terraform -chdir=infra output -raw kafka_ca_certificate > ca.crt
KAFKA_CA_CERT_PATH=

# --- AWS ---
# eu-central-1 (Frankfurt): naechste Region, haelt den Datenverkehr
# innerhalb einer Region.
AWS_REGION=eu-central-1
DYNAMODB_TABLE_SEEN_JOBS=
S3_BUCKET_RAW_ARCHIVE=

# --- Filter und Dedup ---
# Anzeigen, die zwar zum Suchbegriff passen, aber nicht zur Lebenslage.
MATCH_AUSSCHLUSS=praktikum,werkstudent,ausbildung,minijob,aushilfe,schulpraktikum,senior,sr,lead,teamlead,leiter,teamleiter,principal,staff,head of
# Leer bedeutet keine Einschraenkung; sonst muss einer der Begriffe
# vorkommen.
MATCH_PFLICHT=
# Nach dieser Frist vergisst die Dedup-Tabelle eine Anzeige wieder.
DEDUP_AUFBEWAHRUNG_TAGE=180

# --- Notifier (SES, Sandbox-Modus) ---
# Beide Adressen muessen in SES bestaetigt sein - im Sandbox-Modus gilt
# das auch fuer den Empfaenger.
SES_SENDER_ADDRESS=
SES_RECIPIENT_ADDRESS=
# Ein Stapel geht raus, sobald er voll ist oder so lange nichts Neues
# mehr eingetroffen ist.
NOTIFIER_MAX_STAPEL=25
NOTIFIER_WARTEZEIT_SEKUNDEN=60
